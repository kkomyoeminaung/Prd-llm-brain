      "source": [
        "# 🧠 PRD-LLM Backend (Colab Runner)\n",
        "\n",
        "ဒီ Notebook က PRD-LLM ရဲ့ ဉာဏ်ရည်တု အင်ဂျင်ကို Colab GPU သုံးပြီး run ပေးမှာ ဖြစ်ပါတယ်။\n",
        "\n",
        "### 🛠 မစတင်မီ ပြုလုပ်ရန် (Setup Step)\n",
        "1. ဘယ်ဘက်ဘေးက **Key icon (Secrets)** ကို နှိပ်ပါ။\n",
        "2. **Add new secret** ကို နှိပ်ပါ။\n",
        "3. Name မှာ `NGROK_AUTH_TOKEN` လို့ ရိုက်ပါ။\n",
        "4. Value မှာ သင့်ရဲ့ Ngrok dashboard က [Token](https://dashboard.ngrok.com/get-started/your-authtoken) ကို ထည့်ပါ။\n",
        "5. **Notebook access** ခလုတ်ကို **On** ပေးပါ။ (ဒါမှ code က ဒီ key ကို သုံးလို့ရမှာပါ)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. Environment Setup (ဒီ cell ကို အရင် run ပါ)\n",
        "!git clone https://github.com/kkomyoeminaung/Prd-llm-brain.git\n",
        "%cd Prd-llm-brain\n",
        "!pip install -r requirements.txt\n",
        "!pip install pyngrok nest-asyncio"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. Start PRD-LLM Server (ဒီ cell ကို နောက်ဆုံးမှ run ပါ)\n",
        "import nest_asyncio\n",
        "from google.colab import userdata\n",
        "import os\n",
        "import time\n",
        "\n",
        "# Apply nested asyncio for Uvicorn\n",
        "nest_asyncio.apply()\n",
        "\n",
        "# Load Secrets\n",
        "try:\n",
        "    # လူကြီးမင်းထည့်ထားတဲ့ Key ကို ဖတ်မယ်\n",
        "    token = userdata.get('NGROK_AUTH_TOKEN')\n",
        "    os.environ['NGROK_AUTH_TOKEN'] = token\n",
        "    print(\"✅ Ngrok Token successfully loaded from Secrets.\")\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error: Secrets ထဲမှာ NGOOK_AUTH_TOKEN ကို ရှာမတွေ့ပါ။\")\n",
        "    print(\"ကျေးဇူးပြု၍ ဘယ်ဘက်က Key icon မှာ 'NGROK_AUTH_TOKEN' ဆိုတဲ့ နာမည်နဲ့ Token ထည့်ခဲ့ပါ (Space မပါစေနဲ့)။\")\n",
        "\n",
        "# Start the server relay\n",
        "print(\"🚀 Starting PRD-LLM Engine...\")\n",
        "!python COLAB_SERVER.py"
      ]
    }
  ],
