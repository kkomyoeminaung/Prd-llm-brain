      "source": [
        "# 🧠 PRD-LLM: Brain-Architecture Intelligence (Colab Runner)\n",
        "\n",
        "ဒီ Notebook က PRD-LLM ရဲ့ Backend Server ကို Colab မှာ run ပေးမှာဖြစ်ပါတယ်။\n",
        "\n",
        "### ⚠️ အရေးကြီးသော အဆင့် (မဖြစ်မနေ လုပ်ရန်)\n",
        "1. ဘယ်ဘက် ဘေးဘားက **Key (Secrets)** icon ကို နှိပ်ပါ။\n",
        "2. **Add new secret** ကို နှိပ်ပြီး နာမည် (Name) နေရာမှာ `NGROK_AUTH_TOKEN` လို့ ရိုက်ပါ။\n",
        "3. တန်ဖိုး (Value) နေရာမှာ သင့်ရဲ့ [Ngrok Token](https://dashboard.ngrok.com/get-started/your-authtoken) ကို ထည့်ပါ။\n",
        "4. **Notebook access** ခလုတ်ကို **On** ပေးပါ။ (ဒါမှ code က key ကို ဖတ်လို့ရမှာပါ)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. Environment Setup (ဒီ cell ကို အရင် run ပါ)\n",
        "!git clone https://github.com/kkomyoeminaung/Prd-llm-brain.git\n",
        "%cd Prd-llm-brain\n",
        "!pip install -r requirements.txt\n",
        "!pip install pyngrok nest-asyncio"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. Start PRD-LLM Server\n",
        "import nest_asyncio\n",
        "from google.colab import userdata\n",
        "import os\n",
        "\n",
        "# Ngrok Token ကို Secrets ထဲကနေ ဖတ်မယ်\n",
        "try:\n",
        "    # လူကြီးမင်း ပုံထဲမှာ မြင်ရတဲ့အတိုင်း NGROK_AUTH_TOKEN ဆိုတဲ့ နာမည်နဲ့ ဖတ်ပေးပါမယ်\n",
        "    token = userdata.get('NGROK_AUTH_TOKEN')\n",
        "    os.environ['NGROK_AUTH_TOKEN'] = token\n",
        "    print(\"✅ Ngrok Token successfully loaded from Secrets.\")\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error: Secrets ထဲမှာ NGROK_AUTH_TOKEN ကို ရှာမတွေ့ပါ။ {e}\")\n",
        "    print(\"ကျေးဇူးပြု၍ ဘယ်ဘက်က Key icon မှာ နာမည်အမှန်နဲ့ ထည့်ပေးပါ (Space မပါစေနဲ့)။\")\n",
        "\n",
        "# Run the server\n",
        "!python COLAB_SERVER.py"
      ]
    }
  ],
