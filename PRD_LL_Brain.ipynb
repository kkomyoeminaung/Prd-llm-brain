      "source": [
        "# 🧠 PRD-LLM Backend (Colab GPU Runner)\n",
        "\n",
        "ဒီ Notebook က PRD-LLM ရဲ့ ဉာဏ်ရည်တု အင်ဂျင်ကို Colab GPU သုံးပြီး run ပေးမှာ ဖြစ်ပါတယ်။\n",
        "\n",
        "### 🛠 အရေးကြီးသော Setup (မrunမီ ဒါကို အရင်လုပ်ပါ)\n",
        "1. ဘယ်ဘက်ဘေးက **Key icon (Secrets)** ကို နှိပ်ပါ။\n",
        "2. ပုံထဲမှာ မြင်ရတဲ့အတိုင်း `NGROK_AUTH_TOKEN` ဆိုတဲ့ နာမည်နဲ့ Token ထည့်ထားပြီးသားဖြစ်ရပါမယ်။\n",
        "3. အဲဒီ Key ရဲ့ ဘေးက **Notebook access ခလုတ်ကို အပြာရောင်ဖြစ်အောင် ဖွင့်ပေးပါ** (ဒါမှ code က key ကို ယူသုံးလို့ရမှာပါ)။\n",
        "4. **သတိပြုရန်:** အပေါ်ဆုံးမှာ တက်နေတဲ့ `userdata.get('secretName')` ဆိုတဲ့ cell အမှားကို run စရာမလိုပါ။ ဖျက်ပစ်လိုက်ပါ။"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# [အဆင့် ၁] - လိုအပ်တာတွေ Install လုပ်ခြင်း (ဒီကောင်ကို အရင်နှိပ်ပါ)\n",
        "import os\n",
        "!git clone https://github.com/kkomyoeminaung/Prd-llm-brain.git\n",
        "%cd Prd-llm-brain\n",
        "!pip install -r requirements.txt\n",
        "!pip install pyngrok nest-asyncio"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# [အဆင့် ၂] - Server စတင်ခြင်း (ဒီကောင်ကို နောက်ဆုံးမှ run ပါ)\n",
        "from google.colab import userdata\n",
        "import os\n",
        "\n",
        "print(\"🔍 Checking Secrets...\")\n",
        "try:\n",
        "    # Secrets ထဲက key ကို ဖတ်မယ်\n",
        "    token = userdata.get('NGROK_AUTH_TOKEN')\n",
        "    os.environ['NGROK_AUTH_TOKEN'] = token\n",
        "    print(\"✅ Ngrok Token successfully loaded.\")\n",
        "    \n",
        "    # Server Start\n",
        "    print(\"🚀 Starting PRD-LLM Engine on Colab GPU...\")\n",
        "    !python COLAB_SERVER.py\n",
        "except Exception as e:\n",
        "    print(\"❌ ERROR: Secrets ဖတ်လို့ မရပါ။\")\n",
        "    print(\"အကြောင်းရင်း: Key icon ထဲမှာ 'NGROK_AUTH_TOKEN' ဆိုတဲ့ ဘေးက 'Notebook access' ခလုတ်လေးကို မဖွင့်ရသေးလို့ ဖြစ်နိုင်ပါတယ်။\")\n",
        "    print(f\"အသေးစိတ်အချက်အလက်: {e}\")"
      ]
    }
  ],
